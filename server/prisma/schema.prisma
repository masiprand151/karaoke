// This is your Prisma schema file,
// learn more about it in the docs:
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUM
// ======================================================

enum DayType {
  REGULAR
  PROMO
  WEEKEND
  PACKAGE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum MasterPasswordType {
  UPDATE
  DISCOUNT
  DELETE
  ALL
}

enum LicenseStatus {
  REGISTERED
  UNREGISTERED
  REVOKED
}

enum TransactionStatus {
  PENDING
  PAID
  CLOSE
  CANCEL
}

enum FnbCategory {
  FOOD
  DRINK
  SNACK
  OTHER
}

enum CompanionStatus {
  AVAILABLE
  BUSY
  OFF
}

enum OrderStatus {
  DRAFT
  SENT
  CANCELLED
}

enum OrderItemType {
  PRODUCT
  COMPANION
}

enum PackageItemType {
  PRODUCT
  COMPANION
}

// ======================================================
// LICENSE
// ======================================================

model License {
  id       Int           @id @default(autoincrement())
  key      String        @unique
  deviceId String?       @unique
  outletId String
  status   LicenseStatus @default(UNREGISTERED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// USER
// ======================================================

model User {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  password   String
  fullAccess Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// MASTER PASSWORD
// ======================================================

model MasterPassword {
  id       Int                @id @default(autoincrement())
  type     MasterPasswordType @unique @default(ALL)
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// ROOM
// ======================================================

model Room {
  id     Int        @id @default(autoincrement())
  name   String     @unique
  type   String
  status RoomStatus @default(AVAILABLE)

  // 1 Room mempunyai banyak harga
  roomPrices RoomPrice[]

  // 1 Room mempunyai banyak transaksi
  transactions Transaction[]
}

// ======================================================
// ROOM PRICE
// ======================================================

model RoomPrice {
  id Int @id @default(autoincrement())

  // FK ke Room
  roomId Int

  // Jenis hari / pricing
  dayType DayType

  // Jam mulai dan selesai
  // contoh:
  // 00:00 - 17:00
  // 17:00 - 00:00
  startTime String
  endTime   String

  price Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  // Relasi ke Room
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Satu RoomPrice dapat digunakan banyak transaksi
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([roomId, dayType])
}

// ======================================================
// SETTING
// ======================================================

model Setting {
  id Int @id @default(autoincrement())

  isActive Boolean @unique @default(true)

  // Pajak
  taxPercent Int @default(10)

  // Service
  servicePercent Int @default(5)
}

// ======================================================
// TRANSACTION
// ======================================================

model Transaction {
  // Invoice number
  id String @id @default(uuid())

  // ====================================================
  // ROOM
  // ====================================================

  // Room tempat transaksi berlangsung
  roomId Int

  // Harga yang digunakan ketika transaksi dibuat
  priceId Int

  // ====================================================
  // CUSTOMER
  // ====================================================

  customerName  String
  customerPhone String?

  people Int @default(1)

  // ====================================================
  // TIME
  // ====================================================

  durationMinute Int

  extendDuration Int @default(0)

  freeDuration Int @default(0)

  startTime DateTime

  endTime DateTime

  // ====================================================
  // CASHIER
  // ====================================================

  cashier String

  // ====================================================
  // STATUS
  // ====================================================

  status TransactionStatus @default(PENDING)

  // ====================================================
  // BILLING
  // ====================================================
  roomTotal   Decimal @db.Decimal(12, 2)
  discPercent Int     @default(0)
  disAmount   Decimal @default(0) @db.Decimal(12, 2)

  fnbTotal       Decimal @default(0) @db.Decimal(12, 2)
  packageTotal   Decimal @default(0) @db.Decimal(12, 2)
  companionTotal Decimal @default(0) @db.Decimal(12, 2)

  subTotal   Decimal @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  service    Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @db.Decimal(12, 2)

  // ====================================================
  // RELATION
  // ====================================================

  // Transaction -> Room
  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  // Transaction -> RoomPrice
  roomPrice RoomPrice @relation(fields: [priceId], references: [id], onDelete: Restrict)

  // ====================================================
  // TIMESTAMP
  // ====================================================

  createdAt DateTime @default(now())

  // ====================================================
  // INDEX
  // ====================================================
  orders Order[]

  @@index([roomId])
  @@index([priceId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
}

// ======================================================
// INVOICE COUNTER
// ======================================================

model InvoiceCounter {
  id Int @id @default(autoincrement())

  date DateTime @unique @db.Date

  lastNumber Int @default(0)
}

model Product {
  id       Int         @id @default(autoincrement())
  name     String @unique
  category FnbCategory
  price    Decimal     @db.Decimal(12, 2)
  stock    Decimal     @default(0) @db.Decimal(12, 2)
  isActive Boolean     @default(true)

  packageItems PackageItem[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([isActive])
}

model Companion {
  id       Int             @id @default(autoincrement())
  name     String
  code     String?         @unique
  price    Decimal         @db.Decimal(12, 2)
  status   CompanionStatus @default(AVAILABLE)
  isActive Boolean         @default(true)

  packageItems      PackageItem[]
  orderItems        OrderItem[]
  packageOrderItems OrderPackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@index([isActive])
}

model Package {
  id             Int     @id @default(autoincrement())
  name           String
  description    String?
  price          Decimal @db.Decimal(12, 2)
  durationMinute Int?
  isActive       Boolean @default(true)

  items  PackageItem[]
  orders OrderPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model PackageItem {
  id        Int             @id @default(autoincrement())
  packageId Int
  type      PackageItemType

  // Jika item adalah F&B
  productId Int?

  // Jika item adalah Companion
  // boleh NULL = companion dipilih nanti / optional
  companionId Int?

  quantity Int @default(1)

  package   Package    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  companion Companion? @relation(fields: [companionId], references: [id], onDelete: Restrict)

  orderItems OrderPackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([productId])
  @@index([companionId])
}

model Order {
  id            Int         @id @default(autoincrement())
  transactionId String
  status        OrderStatus @default(DRAFT)
  note          String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  items    OrderItem[]
  packages OrderPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([status])
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  type    OrderItemType

  productId   Int?
  companionId Int?

  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  companion Companion? @relation(fields: [companionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([companionId])
}

model OrderPackage {
  id Int @id @default(autoincrement())

  orderId   Int
  packageId Int

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  items OrderPackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([packageId])
}

model OrderPackageItem {
  id Int @id @default(autoincrement())

  orderPackageId Int
  packageItemId  Int

  quantity Int @default(1)

  // Companion yang benar-benar dipilih
  // NULL = tidak menggunakan companion
  companionId Int?

  orderPackage OrderPackage @relation(fields: [orderPackageId], references: [id], onDelete: Cascade)

  packageItem PackageItem @relation(fields: [packageItemId], references: [id], onDelete: Restrict)

  companion Companion? @relation(fields: [companionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderPackageId])
  @@index([packageItemId])
  @@index([companionId])
}
